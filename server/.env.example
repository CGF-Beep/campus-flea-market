# 服务端口
PORT=3000

# JWT 配置
# 生产环境务必用 64 位以上随机串：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# 数据库配置 (MySQL 8.0+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_flea_market
DB_USER=root
DB_PASSWORD=your-mysql-password

# 文件上传目录（相对 server/ 的路径）
UPLOAD_DIR=src/uploads

# 前端地址（CORS 白名单与回调域名）
CLIENT_URL=http://localhost:5173

# 信任代理
# 当服务位于 Nginx / CDN / HTTPS 隧道（会注入 X-Forwarded-For）之后时设为 true；
# 直连公网或 TCP 隧道必须保持 false，否则攻击者可伪造 X-Forwarded-For 绕过登录限流。
#
# 【访问分析必读】线上（api.zeroly.me 走 Nginx）必须设为 true，并且 Nginx 的 server 块里要有：
#     proxy_set_header X-Real-IP $remote_addr;
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# 少了这两行，Express 拿到的永远是反代的本机地址，
# visit_sessions.ip_masked 会全部记成 127.0.0.1 / ::1，访问分析的 IP 与 UV 就全废了。
TRUST_PROXY=false

# Cloudflare 代理
# 域名挂 Cloudflare 代理（DNS 记录是橙云「已代理」）时必须设为 true。
# 开启后客户端 IP 取 `CF-Connecting-IP` 头 —— 不开的话拿到的是 CF 边缘节点地址
# （172.64.* / 162.158.* 之类），归属地会显示成旧金山、法兰克福这些 CF 机房位置，
# 访问分析里的 IP 与地区统计全部失真。
#
# 安全前提：只有在「源站确实只在 Cloudflare 后面」时才开。
# 这个头是普通请求头、可被伪造；若将来撤掉 CF 改为直连，必须同步改回 false，
# 否则伪造 CF-Connecting-IP 就能污染访问日志。
CLOUDFLARE_PROXY=false
